            "InputMessageTransformFile": "Transforms/InputSKU101991042.cs",
            "OutputMessageTransformFile": "Transforms/SpikeOutput.cs",
            "PValueHistoryLength": 32,
            "Confidence": 95.0,
            //"System.InvalidOperationException": "The input size for training should be greater than twice the window size.",
            "TrainingWindowSize": 800,
            "SeasonalityWindowSize": 60
         }
      }
   }
