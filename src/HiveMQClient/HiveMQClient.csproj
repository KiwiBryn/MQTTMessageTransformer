<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>79911e03-c643-4aaf-8032-fb1773eb9fae</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HiveMQtt" Version="0.45.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="HiveMQtt.Client" />
    <Using Include="HiveMQtt.MQTT5.ReasonCodes" />
    <Using Include="HiveMQtt.MQTT5.Types" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
  </ItemGroup>

</Project>
